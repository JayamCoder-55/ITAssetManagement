<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ITAssetManagement.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>IT Asset Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    
    <style>
        body { background-color: #f4f6f9; display: flex; flex-direction: column; min-height: 100vh; margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow-x: hidden; }
        .navbar { background-color: #1a2226; border-bottom: 2px solid #0d6efd; }
        .navbar-brand { font-weight: 600; letter-spacing: 0.5px; }
        .navbar-brand, .nav-link, .navbar-text { color: #ffffff !important; }
        
        .sidebar { min-height: calc(100vh - 58px); background-color: #222d32; padding-top: 15px; }
        .sidebar a { color: #b8c7ce; text-decoration: none; padding: 12px 20px; display: block; font-weight: 500; transition: all 0.2s ease-in-out; }
        .sidebar a:hover, .sidebar a.active { color: #ffffff; background-color: #1e282c; border-left: 4px solid #0d6efd; }
        .sidebar h6 { color: #4b646f; font-size: 0.80rem; text-transform: uppercase; padding: 0 20px; margin-top: 20px; margin-bottom: 10px; font-weight: bold; letter-spacing: 1px; }
        
        /* Flex layout fix to eliminate horizontal scrollbar */
        .main-content { padding: 30px; background-color: #f4f6f9; flex: 1; min-width: 0; }
        .card { box-shadow: 0 0 10px rgba(0,0,0,0.05); border: none; border-radius: 8px; }
    </style>
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand" href="#"><i class="bi bi-pc-display-horizontal me-2 text-primary"></i>IT Asset Management</a>
                <div class="d-flex align-items-center">
                    <span class="navbar-text me-4 fs-6">
                        <i class="bi bi-person-circle me-1"></i>
                        <asp:Label ID="lblUserName" runat="server" Text="User" CssClass="fw-bold"></asp:Label> 
                        <span class="badge bg-secondary ms-1"><asp:Label ID="lblUserRole" runat="server" Text="Role"></asp:Label></span>
                    </span>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn btn-outline-light btn-sm" OnClick="btnLogout_Click" CausesValidation="false">
                        <i class="bi bi-box-arrow-right me-1"></i>Sign Out
                    </asp:LinkButton>
                </div>
            </div>
        </nav>

        <div class="container-fluid flex-grow-1 d-flex p-0">
            <div class="sidebar col-md-3 col-lg-2 p-0 d-none d-md-block shadow-sm">
                
                <asp:Panel ID="pnlAdminMenu" runat="server" Visible="false">
                    <h6>Admin Module</h6>
                    <a href='<%= ResolveUrl("~/UI/Admin/ManageAssets.aspx") %>'><i class="bi bi-boxes me-3"></i>Manage Assets</a>
                    <a href='<%= ResolveUrl("~/UI/Admin/ManageUsers.aspx") %>'><i class="bi bi-people me-3"></i>Manage Users</a>
                </asp:Panel>

                <asp:Panel ID="pnlTechMenu" runat="server" Visible="false">
                    <h6>Technician Module</h6>
                    <a href='<%= ResolveUrl("~/UI/Tech/TicketQueue.aspx") %>'><i class="bi bi-list-task me-3"></i>Ticket Queue</a>
                </asp:Panel>

                <asp:Panel ID="pnlEmployeeMenu" runat="server" Visible="false">
                    <h6>Employee Module</h6>
                    <a href='<%= ResolveUrl("~/UI/Employee/MyAssets.aspx") %>'><i class="bi bi-laptop me-3"></i>My Assets</a>
                    <a href='<%= ResolveUrl("~/UI/Employee/SubmitTicket.aspx") %>'><i class="bi bi-ticket me-3"></i>Submit Ticket</a>
                </asp:Panel>
                
            </div>

            <div class="main-content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            </div>
        </div>
    </form>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>